# Environment variables for local development
# Copy this to .env and fill in the required values.

# Frontend
VITE_API_URL="http://localhost:8000/trpc"
VITE_CLERK_PUBLISHABLE_KEY=""

# API / CORS
PORT=8000
CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# Databases
DATABASE_URL="postgresql://rooted:rooted_dev_password@localhost:5433/rooted_planner"
TIMESCALE_DATABASE_URL="postgresql://rooted:rooted_dev_password@localhost:5434/rooted_telemetry"
REDIS_URL="redis://localhost:6379"

# Clerk
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# AWS IoT
AWS_REGION="us-west-2"
AWS_IOT_ENDPOINT=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# MQTT environment isolation
# APP_ENV: local | dev | staging | prod — used to derive a unique MQTT client ID
APP_ENV="local"
# MOCK_IOT=true is the default local path (no real MQTT connection)
MOCK_IOT="true"
# MQTT_ENABLED must also be true to start the real subscriber
MQTT_ENABLED="false"
# Optional overrides:
# MQTT_CLIENT_ID="rooted-api-prod-primary"  # set explicitly in prod
# MQTT_CLEAN_SESSION="false"                # defaults: prod=false, others=true

# Machine config store
CONFIG_TTL_MS=100000
CLEANUP_INTERVAL_MS=60000
