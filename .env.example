# Environment variables for development
# Copy this to .env.local and fill in your values
CORS_ORIGIN="http://localhost:3000"


# Database (for Planner backend - future)
DATABASE_URL="postgresql://rooted:rooted_dev_password@localhost:5432/rooted_planner"

# TimescaleDB (for telemetry data)
TIMESCALE_DATABASE_URL="postgresql://rooted:rooted_dev_password@localhost:5434/rooted_telemetry"

# Redis (for Planner backend - future)
REDIS_URL="redis://localhost:6379"

# Clerk Authentication
# Get these from https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Config Store
CONFIG_TTL_MS=100000
CLEANUP_INTERVAL_MS=60000