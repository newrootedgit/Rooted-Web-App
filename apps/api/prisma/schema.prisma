generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model blend_ingredients {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  blend_id        String?   @db.Uuid
  product_id      String?   @db.Uuid
  percentage      Decimal   @db.Decimal(5, 2)
  timing_override Json?
  blends          blends?   @relation(fields: [blend_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products        products? @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([blend_id], map: "idx_blend_ingredients_blend_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model blends {
  id                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  farm_id           String?             @db.Uuid
  name              String              @db.VarChar(255)
  description       String?
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  blend_ingredients blend_ingredients[]
  farms             farms?              @relation(fields: [farm_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order_items       order_items[]

  @@index([farm_id], map: "idx_blends_farm_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model customers {
  id                        String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  farm_id                   String?                     @db.Uuid
  name                      String                      @db.VarChar(255)
  email                     String?                     @db.VarChar(255)
  phone                     String?                     @db.VarChar(50)
  company_name              String?                     @db.VarChar(255)
  customer_type             String?                     @db.VarChar(50)
  payment_terms             String?                     @db.VarChar(50)
  address                   Json?
  tags                      String[]
  notes                     String?
  is_active                 Boolean?                    @default(true)
  created_at                DateTime?                   @default(now()) @db.Timestamp(6)
  farms                     farms?                      @relation(fields: [farm_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders                    orders[]
  recurring_order_schedules recurring_order_schedules[]

  @@index([farm_id], map: "idx_customers_farm_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model employees {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  farm_id     String?   @db.Uuid
  first_name  String    @db.VarChar(100)
  last_name   String    @db.VarChar(100)
  email       String?   @db.VarChar(255)
  phone       String?   @db.VarChar(50)
  position    String?   @db.VarChar(100)
  status      String?   @default("ACTIVE") @db.VarChar(50)
  hire_date   DateTime? @db.Date
  hourly_rate Decimal?  @db.Decimal(10, 2)
  notes       String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  farms       farms?    @relation(fields: [farm_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([farm_id], map: "idx_employees_farm_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model farm_layouts {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  farm_id     String?   @db.Uuid
  name        String    @db.VarChar(255)
  canvas_data Json
  is_active   Boolean?  @default(true)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  farms       farms?    @relation(fields: [farm_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([farm_id], map: "idx_farm_layouts_farm_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model farm_users {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id     String?   @db.Uuid
  farm_id       String?   @db.Uuid
  clerk_user_id String    @unique @db.VarChar(255)
  role          String    @db.VarChar(50)
  first_name    String?   @db.VarChar(100)
  last_name     String?   @db.VarChar(100)
  email         String?   @db.VarChar(255)
  is_active     Boolean?  @default(true)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  farms         farms?    @relation(fields: [farm_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenants       tenants?  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([clerk_user_id], map: "idx_farm_users_clerk_user_id")
  @@index([farm_id], map: "idx_farm_users_farm_id")
  @@index([tenant_id], map: "idx_farm_users_tenant_id")
}

model farms {
  tenant_id                 String?                     @db.Uuid
  id                        String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                      String                      @db.VarChar(255)
  slug                      String                      @unique @db.VarChar(255)
  logo_url                  String?                     @db.VarChar(500)
  brand_color               String?                     @db.VarChar(7)
  contact_email             String?                     @db.VarChar(255)
  contact_phone             String?                     @db.VarChar(50)
  address                   Json?
  settings                  Json?
  created_at                DateTime?                   @default(now()) @db.Timestamp(6)
  updated_at                DateTime?                   @default(now()) @db.Timestamp(6)
  blends                    blends[]
  customers                 customers[]
  employees                 employees[]
  farm_layouts              farm_layouts[]
  farm_users                farm_users[]
  tenants                   tenants?                    @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  machines                  machines[]
  orders                    orders[]
  product_categories        product_categories[]
  products                  products[]
  rack_assignments          rack_assignments[]
  recurring_order_schedules recurring_order_schedules[]
  supplies                  supplies[]
  supply_categories         supply_categories[]
  tasks                     tasks[]

  @@index([tenant_id], map: "idx_farms_tenant_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model machines {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenant_id          String?   @db.Uuid
  farm_id            String?   @db.Uuid
  name               String    @db.VarChar(255)
  display_name       String?   @db.VarChar(255)
  device_id          String    @db.VarChar(255)
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  aws_iot_thing_name      String?   @unique @db.VarChar(255)
  status                  String?   @default("offline") @db.VarChar(50)
  last_seen_at            DateTime? @db.Timestamp(6)
  current_wifi_ssid       String?   @db.VarChar(255)
  total_steps             BigInt    @default(0)
  total_uptime_ms         BigInt    @default(0)
  current_boot_id         BigInt?
  current_boot_uptime_ms  BigInt    @default(0)
  reboot_count            Int       @default(0)
  belt_fault_count        Int       @default(0)
  blade_fault_count       Int       @default(0)
  tray_count              Int       @default(0)
  last_raw_tray_count     Int       @default(0)
  last_belt_fault         Int       @default(0) @db.SmallInt
  last_blade_fault        Int       @default(0) @db.SmallInt
  current_belt_motor_uptime_ms  BigInt  @default(0)
  total_belt_motor_uptime_ms    BigInt  @default(0)
  current_blade_motor_uptime_ms BigInt  @default(0)
  total_blade_motor_uptime_ms   BigInt  @default(0)
  last_raw_belt_motor_uptime_ms   BigInt  @default(0)
  last_raw_blade_motor_uptime_ms  BigInt  @default(0)
  last_motor_boot_id              BigInt?
  farms                   farms?    @relation(fields: [farm_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenants                 tenants?  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  machine_telemetry       machine_telemetry[]

  @@index([device_id], map: "idx_machines_device_id")
  @@index([farm_id], map: "idx_machines_farm_id")
  @@index([tenant_id], map: "idx_machines_tenant_id")


}

/// This model contains telemetry data from a machine (status_update and event schemas), used for monitoring and debugging.
model machine_telemetry {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  machine_id      String   @db.Uuid
  session_id      String?  @db.VarChar(36)
  received_at     DateTime @db.Timestamp(6)
  type            String?  @db.VarChar(50)
  schema_ver      Int?
  boot_id         BigInt?
  seq             Int?
  uptime_ms       BigInt?
  uptime_s        Int?
  delta_steps     Int?
  torque_pct      Int?     @db.SmallInt
  belt_fault      Int?     @db.SmallInt
  blade_fault     Int?     @db.SmallInt
  alert_bits      Int?
  kill_switch     Int?     @db.SmallInt
  cmd_age_ms      Int?
  udp_fail_count  Int?
  belt_motor_uptime_ms  BigInt?
  blade_motor_uptime_ms BigInt?
  event_code      String?  @db.VarChar(100)
  event_value     Int?
  trays_processed Int?

  machines machines @relation(fields: [machine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@index([machine_id], map: "idx_machine_telemetry_machine_id")
  @@index([session_id], map: "idx_machine_telemetry_session_id")
  @@index([received_at], map: "idx_machine_telemetry_received_at")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model order_items {
  id                 String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  order_id           String?            @db.Uuid
  product_id         String?            @db.Uuid
  blend_id           String?            @db.Uuid
  quantity_oz        Decimal            @db.Decimal(8, 2)
  harvest_date       DateTime           @db.Date
  overage_percent    Decimal?           @default(10.00) @db.Decimal(5, 2)
  trays_needed       Int?
  soak_date          DateTime?          @db.Date
  seed_date          DateTime?          @db.Date
  move_to_light_date DateTime?          @db.Date
  created_at         DateTime?          @default(now()) @db.Timestamp(6)
  blends             blends?            @relation(fields: [blend_id], references: [id], onUpdate: NoAction)
  orders             orders?            @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products           products?          @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  rack_assignments   rack_assignments[]
  tasks              tasks[]

  @@index([harvest_date], map: "idx_order_items_harvest_date")
  @@index([order_id], map: "idx_order_items_order_id")
}

