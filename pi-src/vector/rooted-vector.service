[Unit]
Description=Vector telemetry pipeline for Rooted
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
EnvironmentFile=/etc/default/vector
ExecStart=/home/rooted/.vector/bin/vector --config /opt/rooted-ble/vector/rooted-telemetry.toml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
