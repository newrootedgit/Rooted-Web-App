[Unit]
Description=Rooted Telemetry Ingest (UDP → JSONL)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rooted
Group=rooted
ExecStart=/usr/bin/python3 /opt/rooted-ble/aws/telemetry_ingest.py
Restart=always
RestartSec=5
ReadWritePaths=/home/rooted /opt/rooted-ble

[Install]
WantedBy=multi-user.target
